#!/bin/bash

echo "Building $(git log -1)"
echo "---"

set -Eeuxo pipefail

if test -f .gitmodules; then
    git submodule sync -- libs/fluidsynth
    git submodule update --init -- libs/fluidsynth
fi

PATH=/usr/local/llvm-mingw/bin:$PATH

./tools/make_requests
./tools/make_specfiles
./tools/make_makefiles
autoreconf -f

cd build64
../configure -q -C --enable-werror --enable-archs=i386,x86_64,aarch64,arm64ec,arm --with-mingw=clang CC=clang
make -s
cd ..

git reset --hard
