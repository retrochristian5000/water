PROGRAMS = widl
PARENTSRC = ../wrc

PCH = widl_pch.h
PCH_EXCLUDE = hash.c wpp.c

SOURCES = \
	attribute.c \
	client.c \
	expr.c \
	hash.c \
	header.c \
	metadata.c \
	parser.l \
	parser.y \
	ppl.l \
	ppy.y \
	proxy.c \
	register.c \
	server.c \
	typegen.c \
	typelib.c \
	typetree.c \
	utils.c \
	widl.c \
	widl.man.in \
	wpp.c \
	write_msft.c \
	write_sltg.c

widl_EXTRADEFS = -DINCLUDEDIR="\"${includedir}\"" -DBINDIR="\"${bindir}\"" -DLIBDIR="\"${libdir}\""

INSTALL_DEV = $(PROGRAMS)
