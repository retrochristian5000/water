MODULE    = krnl386.exe16
PARENTSRC = ../../programs/ntvdm

# NTVDM-owned host virtualization sources are compiled here temporarily for
# the in-process WOW compatibility path. Do not move their ownership back.
IMPORTLIB = kernel
DELAYIMPORTS = user32

# The internal name "kernel" is a build invariant, not cosmetic: winebuild
# uses it to emit the core Win16 CallFrom16/CallTo16 relay machinery.
EXTRADLLFLAGS = -m16 -Wb,--dll-name,kernel

VER_PRODUCTVERSION = 1,0,0,0

SOURCES = \
	atom.c \
	dosmem.c \
	dem_disk.c \
	dem_process.c \
	error.c \
	emm386_compat.c \
	file.c \
	fpu.c \
	global.c \
	instr.c \
	int13.c \
	int15.c \
	ntdos_int21_compat.c \
	ntdos_process_compat.c \
	ntdos_absdisk_compat.c \
	int2f.c \
	int31.c \
	interrupts.c \
	ioports.c \
	kernel.c \
	local.c \
	io_sys_compat.c \
	ne_module.c \
	ne_segment.c \
	registry.c \
	relay.c \
	resource.c \
	selector.c \
	snoop.c \
	syslevel.c \
	task.c \
	thunk.c \
	utthunk.c \
	vxd.c \
	win386.c \
	wowthunk.c \
	xms.c
