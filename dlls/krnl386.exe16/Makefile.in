MODULE    = krnl386.exe16
PARENTSRC = ../../programs/ntvdm

# Legacy execution-engine sources are still shared from programs/ntvdm while
# their DOSX/WIN386 provider split is completed. NTVDM DEM services must not
# be linked into KRNL386; NT WOW reaches them through the WOW32 callback bridge.
# NTIO BIOS implementations are source-owned by programs/ntio.sys and remain
# linked only through temporary compatibility bridges until each VDM provider
# owns its BIOS path.
IMPORTLIB = kernel
DELAYIMPORTS = user32

# The internal name "kernel" is a build invariant, not cosmetic: winebuild
# uses it to emit the core Win16 CallFrom16/CallTo16 relay machinery.
EXTRADLLFLAGS = -m16 -Wb,--dll-name,kernel

VER_PRODUCTVERSION = 1,0,0,0

SOURCES = \
	atom.c \
	dosmem.c \
	error.c \
	emm386_compat.c \
	file.c \
	fpu.c \
	global.c \
	instr.c \
	ntdos_int21_compat.c \
	ntdos_process_compat.c \
	ntdos_absdisk_compat.c \
	ntio_bios_compat.c \
	ntio_int13_compat.c \
	ntio_int15_compat.c \
	int2f.c \
	int31.c \
	interrupts.c \
	ioports.c \
	kernel.c \
	local.c \
	io_sys_compat.c \
	ne_module.c \
	ne_segment.c \
	registry.c \
	relay.c \
	resource.c \
	selector.c \
	snoop.c \
	syslevel.c \
	task.c \
	thunk.c \
	utthunk.c \
	vxd.c \
	win386.c \
	wowthunk.c \
	xms.c
