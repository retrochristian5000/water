#include "windef.h"
#include "winuser.h"
#include "resource.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

STRINGTABLE
{
    IDS_EXPLORER_TITLE  "Wine Explorer"
    IDS_PATHBOX_LABEL   "Location:"
    IDS_START_LABEL     "Start"
    IDS_RUN             "&Run..."
    IDS_EXIT_LABEL      "E&xit desktop"
    IDS_EXIT_PROMPT     "Are you sure you want to close all programs and exit the virtual desktop?"
    IDS_DESKTOP_TITLE   "Wine Desktop"
    IDS_TASKBAR_LOCK    "Lock the Taskbar"
}

/* Windows 95/98 Shutdown dialog: the DOS option is visible for historical
 * recognition but disabled until a guest real-mode transition exists. */
IDD_WIN9X_SHUTDOWN DIALOG 0, 0, 258, 123
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shut Down Windows"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "What do you want the computer to do?", -1, 10, 10, 230, 11
    AUTORADIOBUTTON "Shut down the computer", IDC_WIN9X_SHUTDOWN, 16, 29, 225, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Restart the computer", IDC_WIN9X_RESTART, 16, 43, 225, 12
    AUTORADIOBUTTON "Restart the computer in MS-DOS mode", IDC_WIN9X_DOSMODE, 16, 57, 225, 12
    LTEXT "MS-DOS mode is unavailable until the real-mode DOS handoff is implemented.", -1, 16, 74, 227, 19
    DEFPUSHBUTTON "OK", IDOK, 143, 101, 49, 14
    PUSHBUTTON "Cancel", IDCANCEL, 199, 101, 49, 14
END

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* @makedep: explorer.manifest */
1 RT_MANIFEST explorer.manifest
