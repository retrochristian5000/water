/* Water 3D Flower Box configuration. The original Microsoft dialog
 * and registry keys have not been reproduced or claimed as compatible. */

#include "resource.h"
#include "winuser.h"

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDD_FLOWERBOX_CONFIG DIALOGEX 0, 0, 200, 114
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "3D Flower Box (Water)"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT       "Shape:", -1, 9, 12, 47, 10
    COMBOBOX    IDC_FLOWERBOX_SHAPE, 60, 10, 129, 64,
                CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Speed:", -1, 9, 38, 47, 10
    COMBOBOX    IDC_FLOWERBOX_SPEED, 60, 36, 129, 64,
                CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Detail:", -1, 9, 64, 47, 10
    COMBOBOX    IDC_FLOWERBOX_DETAIL, 60, 62, 129, 64,
                CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 88, 92, 48, 14
    PUSHBUTTON  "Cancel", IDCANCEL, 142, 92, 48, 14
END
