	branch = master
	shallow = true

[submodule "toolchains/bash"]
	path = toolchains/bash
	url = https://github.com/retrochristian5000/bash.git
	branch = master
	shallow = true

[submodule "toolchains/automake"]
	path = toolchains/automake
	url = https://github.com/retrochristian5000/automake.git
